<footer class="footer on-dark">
  <div class="container grid footer__grid">

    <div class="footer__about">
      {# 푸터는 늘 어두우므로 한글 로고타이프의 반전판을 쓴다.
         874:126 ≒ 6.94:1 — 높이 28px 에 맞춘 폭이 194px 이다. #}
      <a class="footer__logo" href="/" aria-label="{{ site.legalName }} 홈">
        <img src="{{ site.logo.krReverse }}" alt="{{ site.legalName }}" width="194" height="28">
      </a>
      <p data-en="{{ site.descriptionEn }}">{{ site.description }}</p>
    </div>

    {% for item in site.nav %}
      {% if item.children %}
        <div class="footer__links">
          <h4>{{ item.label }}</h4>
          <ul>
            {% for child in item.children %}
              <li><a href="{{ child.url }}">{{ child.label }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    {% endfor %}

    <div class="footer__links">
      <h4>Company</h4>
      <ul>
        {% for item in site.nav %}
          {% if not item.children %}
            <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endif %}
        {% endfor %}
        {% for link in site.footerLinks %}
          <li><a href="{{ link.url }}" data-en="{{ link.labelEn }}">{{ link.label }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer__contact">
      <h4>Contact</h4>
      <ul class="stack" style="--flow: var(--space-2)">
        <li data-en="{{ site.contact.addressEn }}">{{ site.contact.address }}</li>

        {# 전화와 팩스는 생김새가 같아 둘 다 라벨을 붙인다. 한쪽에만 붙이면
           라벨 없는 쪽이 무엇인지 알 수 없다 — 「팩스」 만 있고 전화는 맨숭맨숭한
           상태였다 (2026-08-17 사용자 지적). #}
        <li data-en="Tel">
          전화 <a href="{{ site.contact.tel | telUri }}"
                  data-en="{{ site.contact.tel | intlPhone }}">{{ site.contact.tel }}</a>
        </li>

        {# 팩스는 링크로 걸지 않는다 — 누를 수 있게 보이면 눌러 보게 되는데,
           `fax:` 스킴을 아는 브라우저가 없어 아무 일도 일어나지 않는다.
           값이 없으면 행 자체를 만들지 않는다 — 빈 칸은 「없다」 가 아니라
           「관리가 안 된다」 로 읽힌다. #}
        {% if site.contact.fax %}
          <li data-en="Fax {{ site.contact.fax | intlPhone }}">팩스 {{ site.contact.fax }}</li>
        {% endif %}
        <li><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></li>
      </ul>
    </div>

  </div>

  <div class="container footer__bottom">
    <p>© {{ build.year }} {{ site.legalNameEn }} All rights reserved.</p>
  </div>
</footer>
